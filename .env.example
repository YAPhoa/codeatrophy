# Codeathropy configuration. Copy to .env and adjust:
#
#   cp .env.example .env
#
# Every variable is optional; the value shown is the default unless noted.
# Docker Compose reads this file for variable substitution and passes it to
# the app container.

# --- Compose -------------------------------------------------------------------

# Services to start. "judge0" runs the Judge0 judge engine containers. To run
# without a judge engine, remove it here AND set CODEATHROPY_JUDGE_ENGINE=none.
COMPOSE_PROFILES=judge0

# Host address and port the app is published on. Loopback only by default:
# the app has no authentication and can execute code. Put it behind an
# authenticating reverse proxy before exposing it.
CODEATHROPY_BIND_ADDRESS=127.0.0.1
CODEATHROPY_HOST_PORT=8080

# Image tag and version string of the app build.
# CODEATHROPY_VERSION=0.1.0

# --- Server --------------------------------------------------------------------

# Listen address inside the container (or of the binary).
# CODEATHROPY_ADDR=:8080

# Data directory: the SQLite database and the generated secret key live here.
# The container uses /data, backed by the codeathropy-data volume.
# CODEATHROPY_DATA_DIR=./data

# Database file. Defaults to <data dir>/codeathropy.db.
# CODEATHROPY_DB_PATH=

# Key for encrypting stored API keys (AES-256-GCM): 32 bytes as 64 hex
# characters or base64. When unset, a key is generated on first start into
# <data dir>/secret.key (mode 0600). Generate one with: openssl rand -hex 32
# CODEATHROPY_SECRET_KEY=

# Logging: debug, info, warn or error; text or json.
# CODEATHROPY_LOG_LEVEL=info
# CODEATHROPY_LOG_FORMAT=text

# Public base URL of this instance when it is reached through a reverse
# proxy, e.g. https://codeathropy.example.com. It is published as the MCP
# endpoint's full URL (GET /api/v1/meta, mcp.url) and its origin is allowed
# to send state-changing requests. Unset: clients derive URLs themselves.
# CODEATHROPY_PUBLIC_URL=

# Extra origins (comma-separated, e.g. https://codeathropy.example.com) allowed
# to send state-changing API requests. The server's own origin and loopback
# origins are always allowed. Needed behind a reverse proxy that changes the
# Host header.
# CODEATHROPY_ALLOWED_ORIGINS=

# Size limits: bundle uploads (bytes) and submitted source code (bytes).
# CODEATHROPY_MAX_IMPORT_BYTES=52428800
# CODEATHROPY_MAX_SOURCE_BYTES=65536

# --- Judge engine --------------------------------------------------------------

# judge0 or none. Compose defaults to none unless set here.
CODEATHROPY_JUDGE_ENGINE=judge0

# Number of submissions judged at the same time, and executions run in
# parallel for one submission.
# CODEATHROPY_JUDGE_WORKERS=2
# CODEATHROPY_JUDGE_CONCURRENCY=4

# Judge0 base URL. Compose points it at its own Judge0 service.
# CODEATHROPY_JUDGE0_URL=http://judge0-server:2358

# Shared token for Judge0's X-Auth-Token header. Compose passes it to Judge0
# as AUTHN_TOKEN as well. Empty disables Judge0 authentication (Judge0 is only
# reachable on the stack's internal network).
# CODEATHROPY_JUDGE0_AUTH_TOKEN=

# Use cgroup-based time and memory accounting in Judge0. Only works on hosts
# that still provide cgroup v1; leave false on cgroup v2 hosts (most current
# distributions), where per-process limits are used instead.
# CODEATHROPY_JUDGE0_CGROUPS=false

# Per-language address space (KB) added to a problem's memory limit in
# per-process mode, e.g. "javascript=1048576,go=262144". Defaults:
# c/cpp/rust/python 65536, go/ruby/csharp 131072, javascript/typescript
# 786432, java/kotlin 524288.
# CODEATHROPY_JUDGE0_MEMORY_ALLOWANCES=

# Maximum time one execution may take, including queueing in Judge0.
# CODEATHROPY_JUDGE0_TIMEOUT=5m

# Judge0's own database and queue passwords, and its worker process count.
# The services are reachable only on the stack's internal network; change the
# passwords anyway.
# JUDGE0_POSTGRES_PASSWORD=codeathropy-judge0-postgres
# JUDGE0_REDIS_PASSWORD=codeathropy-judge0-redis
# JUDGE0_WORKER_COUNT=4

# --- AI providers --------------------------------------------------------------
# Values saved in the app's settings take precedence over these.

# Active provider when none is selected in the settings: anthropic,
# openai_compatible or none.
# CODEATHROPY_AI_PROVIDER=

# Maximum duration of one AI request. AI routes allow about six minutes per
# HTTP request, so keep this below that.
# CODEATHROPY_AI_TIMEOUT=5m

# Anthropic. ANTHROPIC_API_KEY is used when CODEATHROPY_ANTHROPIC_API_KEY is
# unset. The default model is claude-opus-5-5.
# CODEATHROPY_ANTHROPIC_API_KEY=
# CODEATHROPY_ANTHROPIC_MODEL=
# CODEATHROPY_ANTHROPIC_BASE_URL=

# Any OpenAI-compatible chat-completions endpoint (OpenAI, OpenRouter, Ollama,
# LM Studio, vLLM, ...). OPENAI_API_KEY is used when
# CODEATHROPY_OPENAI_API_KEY is unset. A model is required; the base URL
# defaults to https://api.openai.com/v1. A key is optional for a custom base
# URL (local servers).
# CODEATHROPY_OPENAI_API_KEY=
# CODEATHROPY_OPENAI_MODEL=
# CODEATHROPY_OPENAI_BASE_URL=

# --- MCP -----------------------------------------------------------------------

# Set false to remove the /mcp endpoint.
# CODEATHROPY_MCP_ENABLED=true

# When set, MCP requests must send "Authorization: Bearer <token>". Set one
# before making the endpoint reachable from anywhere but the local machine.
# CODEATHROPY_MCP_TOKEN=

# Extra Origin values (comma-separated) accepted on the MCP endpoint, in
# addition to the server's own and loopback origins.
# CODEATHROPY_MCP_ALLOWED_ORIGINS=
