# Codeatrophy configuration. Copy to .env and adjust:
#
#   cp .env.example .env
#
# Every variable is optional; the value shown is the default unless noted.
# A variable that turns something on or off takes on/off, true/false,
# yes/no, 1/0 or t/f, in any case.
# Docker Compose reads this file for variable substitution and passes it to
# the app container.

# --- Compose -------------------------------------------------------------------

# Services to start. "judge0" runs the Judge0 judge engine containers. To run
# without a judge engine, remove it here AND set CODEATROPHY_JUDGE_ENGINE=none.
COMPOSE_PROFILES=judge0

# Host address and port the app is published on. Loopback only by default.
# Before exposing it, keep sign-in on (below), serve it over HTTPS and set an
# MCP token. When publishing on another
# address, also set CODEATROPHY_PUBLIC_URL or CODEATROPHY_ALLOWED_HOSTS
# below, or the server refuses requests for that address.
CODEATROPHY_BIND_ADDRESS=127.0.0.1
CODEATROPHY_HOST_PORT=8484

# Release of the app image to run, ghcr.io/yaphoa/codeatrophy:<version>.
# Unset, the release this checkout installs, written in compose.yaml. The
# version the app reports is not set here but when its image is built.
# CODEATROPHY_VERSION=

# --- Server --------------------------------------------------------------------

# Listen address. The binary defaults to loopback only, 127.0.0.1:8484; the
# container listens on all its interfaces, :8484 (Compose and the image set
# it), so that the port can be published.
# CODEATROPHY_ADDR=127.0.0.1:8484

# Data directory: the generated secret key lives here, and the SQLite
# database when SQLite is used. It is needed with PostgreSQL too. The
# container uses /data, backed by the codeatrophy-data volume.
# CODEATROPHY_DATA_DIR=./data

# Key for encrypting stored API keys (AES-256-GCM): 32 bytes as 64 hex
# characters or base64. When unset, a key is generated on first start into
# <data dir>/secret.key (mode 0600). Generate one with: openssl rand -hex 32
# CODEATROPHY_SECRET_KEY=

# Logging: debug, info, warn or error; text or json.
# CODEATROPHY_LOG_LEVEL=info
# CODEATROPHY_LOG_FORMAT=text
# Log every request (method, path, status, size, duration, client) at info
# instead of debug, e.g. to check a reverse proxy setup.
# CODEATROPHY_ACCESS_LOG=off

# Public base URL of this instance when it is reached other than as
# localhost, e.g. https://codeatrophy.example.com or http://192.168.1.20:8484.
# It is published as the MCP endpoint's full URL (GET /api/v1/meta, mcp.url),
# its host is accepted in the Host header, and its origin is allowed to send
# state-changing requests. Unset: clients derive URLs themselves.
# CODEATROPHY_PUBLIC_URL=

# Extra host names or addresses (comma-separated, ports ignored) accepted in
# the Host header of API and MCP requests, e.g. 192.168.1.20,nas.local, for
# reaching the app over the LAN. Loopback names and addresses, the host of
# CODEATROPHY_PUBLIC_URL and the hosts of the allowed origins are always
# accepted; any other host is refused with 403, which blocks DNS-rebinding
# attacks from web pages. "*" accepts any host (only behind a proxy that
# checks it).
# CODEATROPHY_ALLOWED_HOSTS=

# Extra origins (comma-separated, e.g. https://codeatrophy.example.com) allowed
# to send state-changing API requests, in addition to loopback origins, the
# origin of CODEATROPHY_PUBLIC_URL and origins on an allowed host. Their
# hosts are also accepted in the Host header.
# CODEATROPHY_ALLOWED_ORIGINS=

# Size limits: bundle uploads (bytes, at least 1024), submitted source code
# (bytes, 1024 to 16777216) and an item's private notes (characters, 1 to
# 100000). Notes saved under a higher limit stay readable; only a save that
# changes them is held to it.
# CODEATROPHY_MAX_IMPORT_BYTES=52428800
# CODEATROPHY_MAX_SOURCE_BYTES=65536
# CODEATROPHY_MAX_NOTES_CHARS=4000

# Most links an item may have (1 to 50). An item linked under a higher limit
# keeps its links; only adding one is refused, and an import leaves out the
# links over it.
# CODEATROPHY_MAX_LINKS_PER_ITEM=30

# Most test cases one AI generation writes (1 to 100). The default suits most
# uses: more makes each generation slower and costlier, more likely to be cut
# off and retried, and lower in quality (near-duplicates, wrong outputs).
# CODEATROPHY_MAX_GENERATED_TEST_CASES=30

# Most large test cases one AI generation asks for (1 to 20). Keep the default:
# each is a generator program the judge runs, so more also lengthen the check.
# CODEATROPHY_MAX_LARGE_TEST_CASES=5

# --- Sign-in -------------------------------------------------------------------

# Require signing in to the web UI and the HTTP API: on or off. While no
# account exists, the web UI's sign-in page creates the first one with an
# email and password, so create it right after the first start. Manage accounts
# and reset a forgotten password with "codeatrophy user" (with Compose:
# docker compose exec app codeatrophy user help). off skips sign-in: anyone
# who can reach the port can use the app, as on an instance from before
# sign-in existed. Use it only on a machine only you use, or behind a reverse
# proxy that already authenticates. While sign-in is on, /mcp needs a bearer
# token: one made in the web UI (Settings > MCP server > Tokens), or
# CODEATROPHY_MCP_TOKEN below.
# CODEATROPHY_AUTH=on

# How long a sign-in lasts without being used (at least 2h). Each use renews
# it, so a browser you use every few weeks stays signed in.
# CODEATROPHY_SESSION_TTL=720h

# Reverse proxies in front of the app (comma-separated addresses or CIDR
# prefixes) whose X-Forwarded-For header names the client. Failed sign-ins
# are limited per client (10 per 15 minutes); without this, every client
# behind a proxy has the proxy's address and they share that limit, though
# a browser that has signed in before always has a count of its own. List
# only proxies you run: a listed address can claim to be any client. With
# Compose and a proxy on the host, the app sees the Docker network's
# gateway, e.g. 172.16.0.0/12; on the same machine, 127.0.0.1.
# CODEATROPHY_TRUSTED_PROXIES=

# --- Database ------------------------------------------------------------------

# PostgreSQL connection URL (postgres:// or postgresql://). Unset, the app
# uses SQLite at CODEATROPHY_DB_PATH. Compose sets it to its own db service,
#   postgres://codeatrophy:<CODEATROPHY_POSTGRES_PASSWORD>@db:5432/codeatrophy?sslmode=disable
# unless it is set here; set it empty (CODEATROPHY_DATABASE_URL=) to keep the
# library in SQLite in the codeatrophy-data volume instead. The password is
# never logged.
# CODEATROPHY_DATABASE_URL=

# Password of the database user of the Compose db service, used in the URL
# above. PostgreSQL takes it when its volume is first created; changing it
# later also needs, while the old one still works:
#   docker compose exec db psql -U codeatrophy -c "ALTER USER codeatrophy PASSWORD 'new'"
# Use letters, digits and - _ . ~ only (it is part of a URL). The database is
# reachable only on the stack's internal network; change the password anyway,
# and do so before exposing the instance.
# CODEATROPHY_POSTGRES_PASSWORD=codeatrophy-postgres

# SQLite database file. Defaults to <data dir>/codeatrophy.db. With
# PostgreSQL it is the file imported automatically (see below).
# CODEATROPHY_DB_PATH=

# With PostgreSQL: when the PostgreSQL database holds no library yet and a
# SQLite database exists at CODEATROPHY_DB_PATH, the server copies it over at
# startup and renames the file to <name>.migrated-<UTC timestamp>, which
# stays as a backup. off disables that.
# CODEATROPHY_SQLITE_IMPORT=on

# Apply pending schema migrations at startup (on), or leave the schema to
# you (off): the server then starts only on a database at its own schema
# version, does not run the SQLite import above, and otherwise stops and
# says to run "codeatrophy db migrate" (with Compose:
# docker compose run --rm app db migrate), which migrates either way.
# CODEATROPHY_DB_AUTO_MIGRATE=on

# --- Judge engine --------------------------------------------------------------

# judge0 or none. Compose defaults to none unless set here.
CODEATROPHY_JUDGE_ENGINE=judge0

# Number of submissions judged at the same time, and executions run in
# parallel for one submission.
# CODEATROPHY_JUDGE_WORKERS=2
# CODEATROPHY_JUDGE_CONCURRENCY=4

# Judge0 base URL. Compose points it at its own Judge0 service.
# CODEATROPHY_JUDGE0_URL=http://judge0-server:2358

# Shared token for Judge0's X-Auth-Token header. Compose passes it to Judge0
# as AUTHN_TOKEN as well. Empty disables Judge0 authentication (Judge0 is only
# reachable on the stack's internal network).
# CODEATROPHY_JUDGE0_AUTH_TOKEN=

# Judge0's authorization token. The app deletes each submission in Judge0
# once it has read the result, so Judge0 keeps no copy of the code and test
# data it ran; Judge0 allows deleting only with this token. Compose passes it
# to Judge0 as AUTHZ_TOKEN and defaults it to codeatrophy-judge0-authz
# (Judge0 is only reachable on the stack's internal network; change it
# anyway). Empty outside Compose: submissions are then left in Judge0.
# CODEATROPHY_JUDGE0_AUTHZ_TOKEN=codeatrophy-judge0-authz

# Use cgroup-based time and memory accounting in Judge0. Only works on hosts
# that still provide cgroup v1; leave false on cgroup v2 hosts (most current
# distributions), where per-process limits are used instead.
# CODEATROPHY_JUDGE0_CGROUPS=false

# Per-language address space (KB) added to a problem's memory limit in
# per-process mode, e.g. "javascript=1048576,go=262144". Defaults:
# c/cpp/rust/python 65536, go/ruby/csharp 131072, javascript/typescript
# 786432, java/kotlin 524288.
# CODEATROPHY_JUDGE0_MEMORY_ALLOWANCES=

# Maximum time one execution may take, including queueing in Judge0.
# CODEATROPHY_JUDGE0_TIMEOUT=5m

# Judge0's own database and queue passwords, and its worker process count.
# The services are reachable only on the stack's internal network; change the
# passwords anyway.
# JUDGE0_POSTGRES_PASSWORD=codeatrophy-judge0-postgres
# REDIS_PASSWORD=codeatrophy-redis
# JUDGE0_WORKER_COUNT=4

# Caps on the Judge0 workers container as a whole, so that programs it runs
# cannot use up the host's memory or process table (the sandbox only limits
# each process). Memory takes a Docker size (4g, 6144m); raise it with
# JUDGE0_WORKER_COUNT, or for problems whose memory limit is near the 2 GiB
# maximum. A run that hits the cap fails with an error. CPU is not capped
# unless JUDGE0_WORKERS_CPUS is set (a number of CPUs, e.g. 2); a cap makes
# runs slower and can turn them into time limits.
# JUDGE0_WORKERS_MEMORY=4g
# JUDGE0_WORKERS_PIDS=1024
# JUDGE0_WORKERS_CPUS=0

# --- AI providers --------------------------------------------------------------
# AI providers are normally saved in the app's settings. For each kind whose
# variables below are set, the app also offers one read-only "environment"
# provider (ids env-anthropic, env-gemini and env-openai-compatible) that can
# be tested and chosen as the default like a saved one. These variables never
# fill in fields of providers saved in the app.

# Kind whose environment provider is the default until a default is chosen
# in the settings: anthropic, gemini, openai_compatible or none. Once a
# default has been saved there (including "none"), this no longer applies.
# CODEATROPHY_AI_PROVIDER=

# Maximum duration of one AI request, until a request timeout is saved in
# the settings (AI providers).
# CODEATROPHY_AI_TIMEOUT=5m

# Number of AI jobs (drafts, variants, test case and code generation) run
# at the same time; the others wait in the queue.
# CODEATROPHY_AI_WORKERS=2

# Addresses AI providers may connect to. Cloud metadata and other
# link-local addresses (169.254.0.0/16, fe80::/10) are always refused, so a
# base URL cannot be used to read a cloud server's credentials. Loopback and
# private addresses are allowed, for a model server on this machine or your
# network. Set CODEATROPHY_AI_BLOCK_PRIVATE=true to refuse those too, when
# people you don't fully trust have accounts.
# CODEATROPHY_AI_BLOCK_PRIVATE=false

# Host names, IP addresses or CIDR prefixes (comma-separated, no scheme or
# port) that AI providers may connect to whatever the rules above say, such
# as a local model server while CODEATROPHY_AI_BLOCK_PRIVATE is on, e.g.
# ollama,192.168.1.30. A name matches the host of a base URL as written.
# CODEATROPHY_AI_ALLOWED_HOSTS=

# Anthropic environment provider. ANTHROPIC_API_KEY is used when
# CODEATROPHY_ANTHROPIC_API_KEY is unset. The default model is
# claude-opus-5-5.
# CODEATROPHY_ANTHROPIC_API_KEY=
# CODEATROPHY_ANTHROPIC_MODEL=
# CODEATROPHY_ANTHROPIC_BASE_URL=

# Google Gemini environment provider. GEMINI_API_KEY is used when
# CODEATROPHY_GEMINI_API_KEY is unset. A key and a model are required (for
# example gemini-3.5-flash); the base URL defaults to
# https://generativelanguage.googleapis.com/v1beta.
# CODEATROPHY_GEMINI_API_KEY=
# CODEATROPHY_GEMINI_MODEL=
# CODEATROPHY_GEMINI_BASE_URL=

# OpenAI-compatible environment provider: any chat-completions endpoint
# (OpenAI, OpenRouter, Ollama, LM Studio, vLLM, ...). OPENAI_API_KEY is used
# when CODEATROPHY_OPENAI_API_KEY is unset. A model is required; the base URL
# defaults to https://api.openai.com/v1. A key is optional for a custom base
# URL (local servers).
# CODEATROPHY_OPENAI_API_KEY=
# CODEATROPHY_OPENAI_MODEL=
# CODEATROPHY_OPENAI_BASE_URL=

# --- MCP -----------------------------------------------------------------------

# Set false to remove the /mcp endpoint.
# CODEATROPHY_MCP_ENABLED=true

# A server-wide MCP token: when set, MCP requests must send
# "Authorization: Bearer <token>", this one or a token an account made in the
# web UI (Settings > MCP server > Tokens). With sign-in on, the per-account
# tokens are usually all you need. With sign-in off this is the only token:
# set one before making the endpoint reachable from anywhere but the local
# machine. Generate one with: openssl rand -hex 32
# CODEATROPHY_MCP_TOKEN=

# Extra Origin values (comma-separated) accepted on the MCP endpoint, in
# addition to those allowed for the API.
# CODEATROPHY_MCP_ALLOWED_ORIGINS=

# Most MCP sessions open at once; a new session beyond it is refused with 503
# until one closes. Idle sessions are closed after 30 minutes.
# CODEATROPHY_MCP_MAX_SESSIONS=100

# Set true to indent the JSON of MCP tool results, for reading them yourself.
# Compact JSON, the default, costs a model fewer tokens.
# CODEATROPHY_MCP_PRETTY_JSON=false
